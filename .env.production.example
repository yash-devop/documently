# Production env. Copy to .env.production on the host and fill in.
# These files are gitignored and are NOT baked into the Docker image;
# docker compose injects this file into the server/worker containers.
ENV_FILE=production

# Public origin of the web app. Drives CORS + better-auth trustedOrigins.
NEXT_PUBLIC_FRONTEND_URL=https://yourdomain.com

# Public origin of the API. Must be https in production so that
# better-auth can set SameSite=None cookies.
BETTER_AUTH_URL=https://api.yourdomain.com

# Generate a fresh one per environment: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Database / queue -------------------------------------------------
# Production uses a MANAGED database (e.g. Neon). This single URL is read by
# everything: the server/worker containers AND `pnpm prisma:prod` on the host.
# One variable means migrations and the app can never end up on different
# databases. Copy the connection string from your provider's dashboard.
#
# Tip: use your provider's DIRECT connection string here. Transaction-mode
# poolers (Neon's "-pooler." host) can break `prisma migrate deploy`.
DATABASE_URL=postgresql://USER:PASSWORD@your-db-host/documently_db?sslmode=require

# Redis is always the compose container, so this value is ignored by the app.
REDIS_URL=redis://localhost:6379

# The db service is UNUSED in production (you are on a managed database), but it
# still starts, and the postgres image refuses to boot without a password.
# These values are ignored by the app — they only keep that container happy.
POSTGRES_USER=documently
POSTGRES_PASSWORD=unused-in-production
POSTGRES_DB=documently_db

# --- OAuth providers ---------------------------------------------------
# Also add these callback URLs in the Google/GitHub consoles:
#   <BETTER_AUTH_URL>/callback/google
#   <BETTER_AUTH_URL>/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_API_KEY=

# --- LLM --------------------------------------------------------------
GOOGLE_GEMINI_API_KEY=

# --- S3 (document storage) --------------------------------------------
AWS_REGION=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET=

# --- Email (verification) ---------------------------------------------
# Sent over Gmail SMTP. Without these the server logs emails to the console
# instead of sending them, so local dev needs no mail account. Required in
# production.
#
# Gmail is fine for a small beta (about 500 sends/day) but ties the From
# address to a @gmail.com account. Swap these two values for a real provider
# (Amazon SES, Brevo, Mailgun, or your host's SMTP) before a public launch.
SMTP_USER=
SMTP_PASS=
