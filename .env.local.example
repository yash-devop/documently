# Local development env. Copy to .env.local and fill in.
# Which file docker compose loads for the server/worker containers.
ENV_FILE=local

# Where the browser loads the web app from. Used for CORS + better-auth trustedOrigins.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Public origin of the API server. better-auth uses it for baseURL and cookie SameSite.
BETTER_AUTH_URL=http://localhost:8000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Database / queue -------------------------------------------------
# NOTE: docker compose overrides DATABASE_URL and REDIS_URL with internal
# Docker DNS (db:5432, redis:6379). These values are what host-side commands
# (e.g. prisma migrate) use.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=documently_db
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/documently_db?schema=public
REDIS_URL=redis://localhost:6379

# --- OAuth providers ---------------------------------------------------
# Secrets are the client *secret* values, not the public ids.
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_API_KEY=

# --- LLM --------------------------------------------------------------
GOOGLE_GEMINI_API_KEY=

# --- S3 (document storage) --------------------------------------------
AWS_REGION=
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET=

# --- Email (verification) ---------------------------------------------
# Sent over Gmail SMTP. Without these the server logs emails to the console
# instead of sending them, so local dev needs no mail account. Required in
# production.
#
# Use a Google account with 2FA enabled, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it here with the spaces
# removed. Ordinary account passwords will not work.
SMTP_USER=
SMTP_PASS=
