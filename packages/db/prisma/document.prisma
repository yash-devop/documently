enum DOCUMENT_STATUS {
  PROCESSING
  READY
  FAILED
}

model Document {
  id           String          @id @default(cuid())
  userId       String
  mimeType     String
  originalName String
  storageKey   String
  size         Int
  status       DOCUMENT_STATUS @default(PROCESSING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt()
  user         User            @relation(fields: [userId], references: [id])

  @@map("document")
}
