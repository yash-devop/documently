{
  "name": "documently",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "compose:up": "docker compose --env-file apps/server/.env.local up -d",
    "compose:down": "docker compose down",
    "prisma:generate": "cd packages/db && pnpm prisma generate --config=prisma7.config.ts",
    "prisma:format": "cd packages/db && pnpm prisma format --config=prisma7.config.ts",
    "prisma:prod": "cd packages/db && pnpm prisma migrate deploy --config=prisma7.config.ts",
    "prisma:dev": "cd packages/db && pnpm prisma db push --config=prisma7.config.ts",
    "prisma:reset": "cd packages/db && pnpm prisma migrate reset --config=prisma7.config.ts"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=22"
  }
}
